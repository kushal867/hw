# PostgreSQL connection for the app role (member of anon, authenticated, service_role). See docs/DATABASE.md.
DATABASE_URL=postgresql://edusathi_app:CHANGE_ME@127.0.0.1:5432/edusathi
# Public URL of the site (used in emails and invite links). Production: https://www.edusathi.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where PDFs (private) and avatars (public) are stored on disk. Must be writable by the app user.
STORAGE_DIR=./storage
# Upload limit in MB (default 10; keep nginx client_max_body_size a little higher)
MAX_UPLOAD_MB=10

# Email (optional). With SMTP unset, sign-ups are verified automatically and password-reset links are only
# written to the server log. Set these to require email verification and send real reset emails.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM="EduSathi <no-reply@edusathi.tech>"
